{
  "name": "codedesk",
  "productName": "CodeDesk",
  "version": "0.1.0",
  "private": true,
  "description": "A Windows coding agent for DeepSeek and compatible APIs",
  "author": "CodeDesk",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "node scripts/smoke.mjs",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && node scripts/package.mjs"
  },
  "build": {
    "appId": "dev.codedesk.desktop",
    "productName": "CodeDesk",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "resources/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "CodeDesk-${version}-Windows.exe"
    }
  },
  "dependencies": {
    "diff": "^9.0.0",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
